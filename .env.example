# Application
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/certificate_generator

# Redis (for BullMQ queue)
REDIS_URL=redis://localhost:6379

# Email Service (Resend)
RESEND_API_KEY=
FROM_EMAIL=certificates@yourdomain.com
FROM_NAME=Certificate Generator

# Email Service (SendGrid - alternative to Resend)
SENDGRID_API_KEY=

# Certificate
CERTIFICATE_TEMPLATE_PATH=./certificate-templates/base.png
CERTIFICATE_OUTPUT_PATH=./generated-certificates
CERTIFICATE_FONT_PATH=./certificate-templates/fonts/font.ttf

# JWT (if you add authentication later)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend (if using Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3000/api
